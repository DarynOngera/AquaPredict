# Copy to .env.demo. This file is ignored and must never be committed.
# The credential directory must contain gee_key.json from the service account.
GEE_PROJECT=your-google-cloud-project-id
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_CREDENTIALS_DIR=./credentials

# Set this to the public demo origin before deployment.
CORS_ORIGINS=https://demo.example.com

# Change only when the host's port 80 is unavailable.
DEMO_PORT=80

# Optional: mirror prediction, forecast, and generated-report metadata to a
# Databricks SQL Warehouse. Leave disabled for the normal local demo.
DATABRICKS_ENABLED=false
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=your-sql-warehouse-id
# Optional but recommended: exact value from SQL Warehouse Connection Details.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-sql-warehouse-id
DATABRICKS_CATALOG=aquapredict
DATABRICKS_SCHEMA=reporting
# Recommended: service-principal OAuth machine-to-machine credentials.
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Set true only when creating or maintaining the Genie Agent through the
# bootstrap script. Parent path is optional.
DATABRICKS_GENIE_ENABLED=false
DATABRICKS_GENIE_TITLE=AquaPredict Decision Intelligence
DATABRICKS_GENIE_PARENT_PATH=
# Comma-separated Databricks login emails. These users receive read-only Gold
# and Ops access whenever the decision layer is refreshed.
DATABRICKS_GENIE_READERS=
# Legacy alternative only; leave empty when using OAuth.
DATABRICKS_TOKEN=
